{
  "name": "@akonwi/mica",
  "version": "0.14.0",
  "description": "Custom elements. Native behavior. Nearly no JavaScript.",
  "keywords": [
    "css",
    "custom-elements",
    "web-components",
    "layout",
    "no-build",
    "html-first"
  ],
  "homepage": "https://akonwi.io/mica/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akonwi/mica.git"
  },
  "license": "MIT",
  "author": "Akonwi Ngoh",
  "type": "module",
  "exports": {
    ".": "./mica.css",
    "./mica.css": "./mica.css",
    "./avatar.js": {
      "types": "./avatar.d.ts",
      "default": "./avatar.js"
    },
    "./invoker.js": {
      "types": "./invoker.d.ts",
      "default": "./invoker.js"
    },
    "./drawer.js": {
      "types": "./drawer.d.ts",
      "default": "./drawer.js"
    },
    "./field.js": {
      "types": "./field.d.ts",
      "default": "./field.js"
    },
    "./select.js": {
      "types": "./select.d.ts",
      "default": "./select.js"
    },
    "./tabs.js": {
      "types": "./tabs.d.ts",
      "default": "./tabs.js"
    },
    "./toast.js": {
      "types": "./toast.d.ts",
      "default": "./toast.js"
    },
    "./combobox.js": {
      "types": "./combobox.d.ts",
      "default": "./combobox.js"
    },
    "./types/react": {
      "types": "./types/react.d.ts"
    },
    "./header.js": {
      "types": "./header.d.ts",
      "default": "./header.js"
    },
    "./sidebar.js": {
      "types": "./sidebar.d.ts",
      "default": "./sidebar.js"
    },
    "./breadcrumbs.js": {
      "types": "./breadcrumbs.d.ts",
      "default": "./breadcrumbs.js"
    },
    "./table.js": {
      "types": "./table.d.ts",
      "default": "./table.js"
    },
    "./command.js": {
      "types": "./command.d.ts",
      "default": "./command.js"
    },
    "./menu.js": {
      "types": "./menu.d.ts",
      "default": "./menu.js"
    }
  },
  "files": [
    "mica.css",
    "avatar.js",
    "avatar.d.ts",
    "invoker.js",
    "invoker.d.ts",
    "drawer.js",
    "drawer.d.ts",
    "field.js",
    "field.d.ts",
    "select.js",
    "select.d.ts",
    "tabs.js",
    "tabs.d.ts",
    "toast.js",
    "toast.d.ts",
    "combobox.js",
    "combobox.d.ts",
    "types/react.d.ts",
    "THIRD_PARTY_LICENSES.md",
    "header.js",
    "header.d.ts",
    "sidebar.js",
    "sidebar.d.ts",
    "breadcrumbs.js",
    "breadcrumbs.d.ts",
    "table.js",
    "table.d.ts",
    "command.js",
    "command.d.ts",
    "menu.js",
    "menu.d.ts"
  ],
  "sideEffects": true,
  "devDependencies": {
    "axe-core": "^4.12.1",
    "blobatar": "2.4.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0"
  },
  "scripts": {
    "build:avatar": "bun tools/build-avatar.ts",
    "docs:build": "bun tools/build-docs.ts",
    "docs:check": "bun tools/build-docs.ts --check",
    "docs-search:check": "bun tools/docs-search-check.ts",
    "docs:serve": "bun run docs:build && bun tools/serve.ts",
    "snapshot": "bun tools/snapshot.ts",
    "snapshot:check": "bun tools/snapshot.ts --check",
    "snapshot:setup": "playwright install chromium webkit",
    "header:check": "bun tools/header-check.ts",
    "sidebar:check": "bun tools/sidebar-check.ts",
    "navigation-menu:check": "bun tools/navigation-menu-check.ts",
    "bottom-navigation:check": "bun tools/bottom-navigation-check.ts",
    "breadcrumbs:check": "bun tools/breadcrumbs-check.ts",
    "data-table:check": "bun tools/data-table-check.ts",
    "callout:check": "bun tools/callout-check.ts",
    "card-list:check": "bun tools/card-list-check.ts",
    "command:check": "bun tools/command-check.ts",
    "drawer:check": "bun tools/drawer-check.ts",
    "field:check": "bun tools/field-check.ts",
    "combobox:check": "bun tools/combobox-check.ts",
    "menu:check": "bun tools/menu-check.ts && bun tools/menu-touch-check.ts"
  }
}
