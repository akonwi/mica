{
  "name": "@akonwi/mica",
  "version": "0.6.0",
  "description": "Custom elements. Native behavior. Nearly no JavaScript.",
  "keywords": [
    "css",
    "custom-elements",
    "web-components",
    "layout",
    "no-build",
    "html-first"
  ],
  "homepage": "https://akonwi.io/mica/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akonwi/mica.git"
  },
  "license": "MIT",
  "author": "Akonwi Ngoh",
  "type": "module",
  "exports": {
    ".": "./mica.css",
    "./mica.css": "./mica.css",
    "./invoker.js": { "types": "./invoker.d.ts", "default": "./invoker.js" },
    "./drawer.js": { "types": "./drawer.d.ts", "default": "./drawer.js" },
    "./field.js": { "types": "./field.d.ts", "default": "./field.js" },
    "./select.js": { "types": "./select.d.ts", "default": "./select.js" },
    "./tabs.js": { "types": "./tabs.d.ts", "default": "./tabs.js" },
    "./toast.js": { "types": "./toast.d.ts", "default": "./toast.js" },
    "./combobox.js": { "types": "./combobox.d.ts", "default": "./combobox.js" },
    "./types/react": {
      "types": "./types/react.d.ts"
    }
  },
  "files": [
    "mica.css",
    "invoker.js",
    "invoker.d.ts",
    "drawer.js",
    "drawer.d.ts",
    "field.js",
    "field.d.ts",
    "select.js",
    "select.d.ts",
    "tabs.js",
    "tabs.d.ts",
    "toast.js",
    "toast.d.ts",
    "combobox.js",
    "combobox.d.ts",
    "types/react.d.ts"
  ],
  "sideEffects": true,
  "devDependencies": {
    "axe-core": "^4.12.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0"
  },
  "scripts": {
    "snapshot": "bun tools/snapshot.ts",
    "snapshot:check": "bun tools/snapshot.ts --check",
    "snapshot:setup": "playwright install chromium webkit"
  }
}
